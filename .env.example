DECISION_PROVIDER=jevk5
DECISION_API_BASE_URL=http://127.0.0.1:8090
DECISION_MODEL=alibiserikbay/JevK5
DECISION_CONCURRENCY=1
DECISION_TIMEOUT_MS=60000
# Local inference requires no API key. To run without a GPU, set provider=mock.
# Optional hosted provider: DECISION_PROVIDER=typesafe, base=https://api.typesafe.ai,
# model=jev-latest, DECISION_API_KEY=your-key. Keys are server-only.
# Optional cost estimate, USD per million input/output tokens; omit if unknown.
JEV_INPUT_PRICE_PER_MILLION=
JEV_OUTPUT_PRICE_PER_MILLION=
