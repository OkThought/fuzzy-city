# Hosted Jev via Vercel AI Gateway. The key is read only by the server adapter.
JEV_PROVIDER=vercel
AI_GATEWAY_API_KEY=<your Vercel AI Gateway key>
# Optional: DECISION_CONCURRENCY=8 and DECISION_TIMEOUT_MS=60000 are the hosted defaults.
# Local GPU: JEV_PROVIDER=jevk5 (see config/jevk5.env.example).
# Direct TypeSafe fallback: JEV_PROVIDER=typesafe and TYPESAFE_API_KEY=<your TypeSafe key>.
# Optional cost estimate, USD per million input/output tokens; omit if unknown.
JEV_INPUT_PRICE_PER_MILLION=0.04
JEV_OUTPUT_PRICE_PER_MILLION=0
